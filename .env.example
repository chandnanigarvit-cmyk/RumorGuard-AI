# ---- LLM (required) ----
ANTHROPIC_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-5-5

# ---- CORS ----
# "*" is fine for a hackathon. For production use a comma-separated list, e.g.
# CORS_ORIGINS=https://your-app.lovable.app,http://localhost:5173
CORS_ORIGINS=*

# ---- Optional: protect POST /documents (clients must send header X-Admin-Token) ----
ADMIN_TOKEN=

# ---- RAG ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=700
TOP_K=4
# Minimum cosine similarity for a chunk to count as "relevant official evidence"
MIN_SIMILARITY=0.30

# ---- Speech / OCR ----
# tiny | base | small | medium  (bigger = slower but more accurate)
WHISPER_MODEL_SIZE=base
OCR_LANG=eng
# Only needed if the tesseract binary is not on PATH (typical on Windows):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

MAX_UPLOAD_MB=25
